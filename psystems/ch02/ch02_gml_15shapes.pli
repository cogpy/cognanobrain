/* ============================================================================
 * psystems/ch02/ch02_gml_15shapes.pli
 *
 * NanoBrain CH02: Replacing Turing tape with a Fractal tape: FIT & GML
 * Issue #7 — P-Lingua specification (see psystems/README.md).
 *
 * Sections: 2.2.2 (15 geometric shapes are enough to recreate any 1D, 2D or
 *           3D pattern) — inlines common/gml_shapes.pli by convention.
 * Functionality: The GML alphabet has exactly 15 letters: FIVE lines (1D:
 *   straight, and the curve family S, U, L, V, T counted as line classes),
 *   FIVE areas (2D: triangle, square, pentagon, hexagon, circle) and FIVE
 *   volumes (3D: tetrahedron, cube, sphere, cylinder, cone). Any 1D/2D/3D
 *   pattern is recreated by (a) decomposing it into these shapes, (b) nesting
 *   each shape in its encompassing circle/sphere, and (c) recomposing via
 *   harmonic resonance (two copies of a shape produce its octave harmonic).
 *   More than 15 shapes is redundant: any extra shape reduces to a composite.
 * Traceability: src/cpp/nanobrain_fractal_tape.h, src/cpp/nanobrain_fractal.h,
 *               src/cpp/nanobrain_time_crystal.h (GML shapes and harmonics)
 * Initial multiset: one raw pattern per dimension class in the skin, plus the
 *                   15 shape letters distributed over three shape spaces.
 * ==========================================================================*/

@model<psystems_basic>

/* --------------------------------------------------------------------------
 * Membrane structure (2.2.2): one shape space per pattern dimension.
 *
 *   skin
 *     '- lines   : the five 1D letters  (line, curve_s, curve_u, curve_l, angle_v)
 *     '- areas   : the five 2D letters  (triangle, square, pentagon, hexagon, circle)
 *     '- volumes : the five 3D letters  (tetrahedron, cube, sphere, cylinder, cone)
 *
 * (Inlined from common/gml_shapes.pli: shape(N) objects N=1..15 with
 * decompose / resonate / compose rules; shape indices 1-5 = lines,
 * 6-10 = areas, 11-15 = volumes.)
 * ------------------------------------------------------------------------*/
@mu = [ []'lines []'areas []'volumes ]'skin;

/* Sample initial multiset: one raw pattern of each dimensionality, and the
 * full 15-letter alphabet (inlined from common/gml_shapes.pli). */
@mskin = pattern1d(wave_s), pattern2d(tile_hex), pattern3d(lump);
@mlines   = shape(1), shape(2), shape(3), shape(4), shape(5);
@mareas   = shape(6), shape(7), shape(8), shape(9), shape(10);
@mvolumes = shape(11), shape(12), shape(13), shape(14), shape(15);

/* --------------------------------------------------------------------------
 * Evolution rules
 * dispatch_%s  : each raw pattern is sent to the shape space of its
 *                dimensionality
 * decompose    : (common/gml_shapes.pli) a pattern locks onto the shape
 *                letter whose harmonic signature matches — one rule per
 *                dimension class recreates the local piece of the pattern
 * enclose      : every matched shape is enclosed in its encompassing circle
 *                (2D) or sphere (3D); the contact points are the most
 *                energetic and carry the shape's clock
 * resonate     : (common/gml_shapes.pli) two copies of a shape produce a
 *                harmonic (octave up) — recreating a pattern at a new scale
 * compose      : (common/gml_shapes.pli) a harmonic plus a base shape
 *                assembles a composite pattern — arbitrary 1D/2D/3D patterns
 *                are composites of at most 15 letters
 * recreate     : the composite is emitted as the recreated pattern; fifteen
 *                letters suffice, a sixteenth would be a composite of these
 * ------------------------------------------------------------------------*/
[dispatch_1d : pattern1d(P) --> (pattern1d(P))in_lines ]'skin;
[dispatch_2d : pattern2d(P) --> (pattern2d(P))in_areas ]'skin;
[dispatch_3d : pattern3d(P) --> (pattern3d(P))in_volumes ]'skin;

[decompose : pattern1d(P) * shape(S) --> letter(P,S) ]'lines;
[decompose : pattern2d(P) * shape(S) --> letter(P,S) ]'areas;
[decompose : pattern3d(P) * shape(S) --> letter(P,S) ]'volumes;

[enclose : letter(P,S) --> letter_clk(P,S) ]'areas;
[enclose : letter(P,S) --> letter_clk(P,S) ]'volumes;

[resonate : shape(S)*2 --> harmonic(S) ]'lines;
[resonate : shape(S)*2 --> harmonic(S) ]'areas;
[resonate : shape(S)*2 --> harmonic(S) ]'volumes;

[compose : harmonic(S) * letter_clk(P,T) --> composite(P,S,T) ]'areas;
[compose : harmonic(S) * letter_clk(P,T) --> composite(P,S,T) ]'volumes;

[recreate : composite(P,S,T) --> (recreated(P))out ]'areas;
[recreate : composite(P,S,T) --> (recreated(P))out ]'volumes;
[recreate : letter(P,S) --> (recreated(P))out ]'lines;
